---
import { site } from '../data/site';
// Live Instagram grid. Fetches the cached feed from /api/instagram (Netlify
// function, contract in docs/instagram-feed.md) on the client and renders
// permalink tiles — each links to its DIRECT post. Until the feed is live
// (or under `astro dev` where the function isn't served) it shows the
// `fallback` images instead, linking to Gloria's profile, so the grid is
// never empty.
interface FallbackImage { src: string; alt: string }
interface Props {
  limit?: number;
  columns?: number;
  fallback?: FallbackImage[];
  class?: string;
}
const { limit = 12, columns = 4, fallback = [], class: className = '' } = Astro.props;

const IG_GLYPH =
  'M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.897 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.897-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z';
const shown = fallback.slice(0, limit);
---
<div class:list={['ig-feed', className]} data-ig-feed data-ig-limit={limit}>
  <div class="ig-grid" data-ig-grid style={`--cols:${columns}`}>
    {shown.map((img) => (
      <a class="ig-tile" href={site.socials.instagram} target="_blank" rel="noopener" aria-label={`${img.alt} on Instagram`}>
        <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
        <span class="ig-hover" aria-hidden="true">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" set:html={`<path d="${IG_GLYPH}"/>`} />
        </span>
      </a>
    ))}
  </div>
  <p class="ig-follow">
    <a href={site.socials.instagram} target="_blank" rel="noopener">Follow @milestonesbygloria on Instagram →</a>
  </p>
</div>

<!-- Styles are GLOBAL (namespaced under .ig-feed) so they also apply to the
     tiles the client script injects via innerHTML — Astro's scoped-style
     attribute is not added to runtime-generated elements. -->
<style is:global>
  .ig-feed .ig-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), 1fr);
    gap: var(--sp-3);
  }
  .ig-feed .ig-tile {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-bg-warm);
    box-shadow: var(--shadow-soft);
  }
  .ig-feed .ig-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms ease; }
  .ig-feed .ig-tile:hover img { transform: scale(1.05); }
  .ig-feed .ig-hover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(31, 39, 51, 0.35);
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .ig-feed .ig-tile:hover .ig-hover,
  .ig-feed .ig-tile:focus-visible .ig-hover { opacity: 1; }
  .ig-feed .ig-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    color: #fff;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.5));
    z-index: 1;
  }
  .ig-feed .ig-follow {
    text-align: center;
    margin-top: var(--sp-6);
    color: var(--color-accent);
    font-size: var(--fs-body-sm);
    letter-spacing: 0.04em;
  }
  .ig-feed .ig-follow a { border-bottom: 1px solid transparent; transition: border-color 200ms ease; }
  .ig-feed .ig-follow a:hover { border-bottom-color: var(--color-accent); }
  @media (max-width: 900px) { .ig-feed .ig-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 600px) { .ig-feed .ig-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
  const IG_GLYPH = 'M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.897 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.897-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z';
  const PLAY = '<svg class="ig-badge" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.4v13.2l11-6.6Z"/></svg>';
  const HOVER = `<span class="ig-hover" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="${IG_GLYPH}"/></svg></span>`;

  async function loadFeed(root: HTMLElement) {
    const grid = root.querySelector('[data-ig-grid]') as HTMLElement | null;
    const limit = Number(root.getAttribute('data-ig-limit') || '12');
    if (!grid) return;
    try {
      const res = await fetch('/api/instagram', { headers: { accept: 'application/json' } });
      if (!res.ok) return; // keep fallback grid
      const data = await res.json();
      const posts = Array.isArray(data?.posts) ? data.posts.slice(0, limit) : [];
      if (!posts.length) return; // keep fallback grid
      grid.innerHTML = posts
        .map((p: any) => {
          const cap = (p.caption || 'Instagram post').replace(/"/g, '&quot;').slice(0, 120);
          const badge = p.isVideo ? PLAY : '';
          return `<a class="ig-tile" href="${p.permalink}" target="_blank" rel="noopener" aria-label="${cap}">${badge}<img src="${p.image}" alt="${cap}" loading="lazy" decoding="async" />${HOVER}</a>`;
        })
        .join('');
    } catch {
      /* keep fallback grid */
    }
  }

  document.querySelectorAll<HTMLElement>('[data-ig-feed]').forEach(loadFeed);
</script>
