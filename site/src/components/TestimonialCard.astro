---
import type { Testimonial } from '../data/testimonials';
import StarRating from './StarRating.astro';
// Framed testimonial with a photo, quote, star rating, client name and date —
// alternates the photo side to match the mockups' testimonials page.
interface Props {
  item: Testimonial;
  reverse?: boolean;
}
const { item, reverse = false } = Astro.props;
---
<article class:list={['testimonial', { reverse }]}>
  {item.image && (
    <div class="t-photo">
      <img
        src={item.image}
        alt={item.alt ?? ''}
        loading="lazy"
        decoding="async"
        style={item.focus ? `object-position: ${item.focus}` : undefined}
      />
    </div>
  )}
  <div class="t-quote">
    {item.quote.map((p) => <p>{p}</p>)}
    <footer class="t-meta">
      {item.rating && <StarRating rating={item.rating} />}
      <p class="t-author">{item.author}</p>
      {item.date && <p class="t-date">{item.date}</p>}
      {item.context && <p class="t-context">{item.context}</p>}
    </footer>
  </div>
</article>

<style>
  .testimonial {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: var(--sp-6);
    align-items: center;
  }
  .testimonial.reverse .t-photo { order: 2; }
  .t-photo {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }
  .t-photo img { width: 100%; height: 100%; object-fit: cover; }
  .t-quote {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    padding: var(--sp-6);
    background: var(--color-white);
  }
  .t-quote p {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--color-ink);
    margin-bottom: var(--sp-4);
  }
  .t-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-5);
    margin-top: var(--sp-5);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--color-hairline);
  }
  .t-author {
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.9rem;
    color: var(--color-ink);
  }
  .t-date { color: var(--color-accent); font-size: 0.95rem; }
  .t-context {
    width: 100%;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  @media (max-width: 820px) {
    .testimonial, .testimonial.reverse { grid-template-columns: 1fr; }
    .testimonial.reverse .t-photo { order: 0; }
    /* Centred once stacked, matching Testimonial.astro. */
    .t-photo { max-width: 340px; margin: 0 auto; aspect-ratio: 4 / 3; }
  }
</style>
