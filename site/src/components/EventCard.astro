---
// Image tile with a title + caption below — "Events We Plan" grid and the
// Services hub cards. Optional href turns the whole card into a link.
interface Props {
  image: string;
  title: string;
  text?: string;
  href?: string;
  alt?: string;
  class?: string;
}
const { image, title, text, href, alt, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['event-card', { 'is-link': href }, className]} href={href}>
  <div class="event-media">
    <img src={image} alt={alt ?? title} loading="lazy" decoding="async" />
  </div>
  <div class="event-copy">
    <h3 class="event-title serif-h">{title}</h3>
    {text && <p class="event-text">{text}</p>}
  </div>
</Tag>

<style>
  .event-card {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    overflow: hidden;
    color: inherit;
  }
  .event-media { aspect-ratio: 4 / 3; overflow: hidden; }
  .event-media img { width: 100%; height: 100%; object-fit: cover; }
  .event-copy { padding: var(--sp-4) var(--sp-4) var(--sp-5); text-align: center; }
  .event-title {
    font-size: 1.15rem;
    margin-bottom: var(--sp-2);
  }
  .event-text {
    font-size: var(--fs-body-sm);
    color: var(--color-ink-soft);
    line-height: 1.55;
  }
  .is-link {
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .is-link:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }
  .is-link:hover .event-media img { transform: scale(1.03); }
  .event-media img { transition: transform 400ms ease; }
</style>
