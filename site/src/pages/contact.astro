---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import CalcomButton from '../components/CalcomButton.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site } from '../data/site';

const success = Astro.url.searchParams.get('success') === 'true';

const faqs = [
  { q: 'What areas do you serve?', a: 'Milestones by Gloria proudly serves clients throughout British Columbia. If you are planning something a little further out, reach out and we will see how we can help.' },
  { q: 'How do I get started?', a: 'Submit an inquiry through the form on this page or book a complimentary consultation. We will schedule a relaxed call to learn about your vision and recommend the services that fit your celebration.' },
  { q: 'What happens during the consultation?', a: 'It is a relaxed, 30-minute call to share your vision, ask questions, and see if we are the right fit. There is no pressure and no commitment.' },
  { q: 'Do you offer custom packages?', a: 'Yes. Every celebration is different, so packages are tailored to your event size, vision, and budget. Just ask for a custom quote.' },
  { q: 'Do you plan events of all sizes?', a: 'Absolutely, from intimate dinners to celebrations for hundreds of guests. Every detail is managed with the same care.' },
  { q: 'How far in advance should I reach out?', a: 'The earlier the better, so we can secure your date and plan with room to breathe. That said, we also welcome shorter timelines, so do not hesitate to ask.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title="Contact" current="/contact" description="Reach out to Milestones by Gloria. Let's bring your vision to life.">
  <Section bg="default">
    <div class="container-narrow">
      <div class="contact-head text-center">
        <p class="eyebrow">Contact Me</p>
        <p class="script contact-script">Let's bring your vision to life</p>
        <hr class="divider-gold center" />
        <p class="lead contact-lead">
          I'd love to hear about your celebration and how I can help make it unforgettable.
        </p>
      </div>

      <div class="contact-hero-photo mt-7">
        <img src="/images/contact-place-setting.jpg" alt="Elegant place setting with a Milestones by Gloria place card" loading="lazy" decoding="async" />
      </div>

      {success ? (
        <div class="success-card">
          <h2 class="serif-h" style="font-size:1.75rem;font-style:italic;">Thank you!</h2>
          <p class="mt-3">Your message has landed safely. I'll be in touch shortly.</p>
          <a href="/" class="btn btn-gold mt-6">Return Home</a>
        </div>
      ) : (
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/contact?success=true"
          class="contact-form mt-8"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hp"><label>Don't fill this out: <input name="bot-field" /></label></p>

          <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>

          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>

          <div class="form-group">
            <label for="message">Your Message</label>
            <textarea id="message" name="message" required rows="6"></textarea>
          </div>

          <button type="submit" class="btn btn-dark form-submit">Send Message</button>
        </form>
      )}

      <div class="book-card mt-8">
        <div>
          <p class="eyebrow">Prefer to talk it through?</p>
          <h2 class="serif-h book-title">Book a free consultation</h2>
          <p class="book-body">
            A relaxed 30-minute call to share your vision, ask questions, and see if we're the right fit. No pressure, no commitment.
          </p>
        </div>
        <CalcomButton label="Book Free Consultation" />
      </div>

      <div class="alt-contact mt-8">
        <p class="eyebrow text-center">Other Ways to Reach Me</p>
        <div class="alt-grid mt-5">
          <a href={site.emailHref} class="alt-tile" aria-label="Email">
            <span class="alt-icon"><SocialIcon name="email" size={28} /></span>
            <p class="alt-value">{site.email}</p>
          </a>
          {site.socials.instagram && (
            <a href={site.socials.instagram} target="_blank" rel="noopener" class="alt-tile" aria-label="Instagram">
              <span class="alt-icon"><SocialIcon name="instagram" size={28} /></span>
              <p class="alt-value">@milestonesbygloria</p>
            </a>
          )}
          {site.socials.facebook && (
            <a href={site.socials.facebook} target="_blank" rel="noopener" class="alt-tile" aria-label="Facebook">
              <span class="alt-icon"><SocialIcon name="facebook" size={28} /></span>
              <p class="alt-value">/milestonesbygloria</p>
            </a>
          )}
          {site.socials.pinterest && (
            <a href={site.socials.pinterest} target="_blank" rel="noopener" class="alt-tile" aria-label="Pinterest">
              <span class="alt-icon"><SocialIcon name="pinterest" size={28} /></span>
              <p class="alt-value">/milestonesbygloria</p>
            </a>
          )}
        </div>
      </div>

      <div class="faq mt-8">
        <p class="eyebrow text-center">Good to Know</p>
        <h2 class="title-caps faq-title text-center">Frequently Asked Questions</h2>
        <hr class="divider-gold center" />
        <div class="faq-list mt-6">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </Section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>

<style>
  .contact-script { font-size: clamp(2rem, 5vw, 3rem); color: var(--color-accent-soft); margin-top: var(--sp-1); }
  .contact-lead { max-width: 520px; margin: var(--sp-4) auto 0; color: var(--color-ink-soft); }
  .contact-hero-photo { aspect-ratio: 16 / 7; border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-soft); }
  .contact-hero-photo img { width: 100%; height: 100%; object-fit: cover; }

  .faq-title { font-size: var(--fs-h2); margin-bottom: var(--sp-1); }
  .faq-list { display: flex; flex-direction: column; gap: var(--sp-3); max-width: 640px; margin-left: auto; margin-right: auto; }
  .faq-item {
    background: var(--color-white);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    padding: var(--sp-4) var(--sp-5);
  }
  .faq-item summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.1rem;
    color: var(--color-ink);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-4);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+';
    color: var(--color-accent);
    font-size: 1.4rem;
    line-height: 1;
    transition: transform var(--transition);
  }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { color: var(--color-ink-soft); font-size: var(--fs-body-sm); line-height: 1.6; margin-top: var(--sp-3); }

  .contact-form {
    background: var(--color-white);
    padding: var(--sp-7);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
    box-shadow: var(--shadow-soft);
  }
  .form-submit { width: 100%; margin-top: var(--sp-3); }
  .hp { position: absolute; left: -9999px; }

  .success-card {
    text-align: center;
    background: var(--color-white);
    padding: var(--sp-8) var(--sp-7);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
    box-shadow: var(--shadow-soft);
    margin-top: var(--sp-8);
  }

  .alt-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  .alt-tile {
    display: block;
    padding: var(--sp-5);
    background: var(--color-white);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    text-align: center;
    transition: transform var(--transition), box-shadow var(--transition);
    box-shadow: var(--shadow-soft);
  }
  .alt-tile:hover { transform: translateY(-2px); box-shadow: var(--shadow-lift); }
  .alt-icon { display: inline-flex; align-items: center; justify-content: center; color: var(--color-accent); margin-bottom: var(--sp-3); }
  .alt-value { font-family: var(--font-serif); font-style: italic; color: var(--color-ink); font-size: 0.95rem; }

  .book-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sp-5);
    background: var(--color-bg-blush);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: var(--sp-7);
  }
  .book-card > div { max-width: 540px; }
  .book-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.7rem;
    color: var(--color-ink);
    margin: var(--sp-2) 0 var(--sp-3);
  }
  .book-body { color: var(--color-ink-soft); margin: 0; }

  @media (max-width: 700px) {
    .contact-form { padding: var(--sp-5); }
    .alt-grid { grid-template-columns: 1fr; }
    .book-card { padding: var(--sp-5); }
  }
</style>
