---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { testimonials } from '../data/testimonials';
import { site } from '../data/site';
---
<Base title="Testimonials" current="/testimonials" description="Kind words from amazing clients — real moments and unforgettable memories with Milestones by Gloria.">
  <Section bg="default">
    <div class="container">
      <SectionHeading
        eyebrow="Real moments, real experiences, unforgettable memories."
        title="Testimonials"
        script="Kind words from amazing clients"
      >
        <p>It is truly an honour to be part of such meaningful celebrations. Here is what some of my clients have to say about their experience.</p>
      </SectionHeading>

      <div class="testimonial-stack mt-8">
        {testimonials.map((t, i) => <TestimonialCard item={t} reverse={i % 2 === 1} />)}
      </div>

      <div class="t-cta text-center mt-8">
        <p class="script t-cta-script">Thank you for trusting me</p>
        <div class="cta-pair mt-5">
          <a href="/contact" class="btn btn-dark">Inquire Now</a>
          <a href={`https://cal.com/${site.calcomLink}`} target="_blank" rel="noopener" class="btn btn-gold">Book a Consultation</a>
        </div>
      </div>
    </div>
  </Section>
</Base>

<style>
  .testimonial-stack { display: flex; flex-direction: column; gap: var(--sp-8); }
  .t-cta-script { font-size: clamp(1.8rem, 4vw, 2.6rem); color: var(--color-accent-soft); }
</style>
