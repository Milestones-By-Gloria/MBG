---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

// Home "Services Designed for..." row — 5 categories as shown in the mockup.
// Images are stand-ins until Gloria's Canva exports drop in at these paths.
const homeServices = [
  { label: 'Wedding Coordination', icon: 'heart', text: 'For couples who have planned their day and want a trusted professional to bring it all together seamlessly.', image: '/images/reception-round-gold.jpg', href: '/services/wedding-coordination' },
  { label: 'Wedding Planning', icon: 'clipboard-pen', text: 'Thoughtfully planned celebrations, beautifully tailored to your unique love story.', image: '/images/wedding-planning-plan.jpg', href: '/services/wedding-planning' },
  { label: 'Wedding Childcare', icon: 'users-care', text: 'Exceptional care for your youngest guests, so everyone can celebrate with confidence.', image: '/images/childcare-teepee.jpg', href: '/services/childcare' },
  { label: 'Social Events', icon: 'sparkles', text: 'Elegant celebrations designed to bring people together and create lasting memories.', image: '/images/hero-milestone-lakeside.jpg', href: '/services/milestones' },
  { label: 'Corporate Events', icon: 'handshake', text: 'Refined event experiences that reflect your brand with professionalism and purpose.', image: '/images/reception-navy-banquet.jpg', href: '/services/corporate-events' },
];

const experience = [
  { icon: 'message', title: 'Inquire', text: 'Share your vision, your story, and your dreams.' },
  { icon: 'message-heart', title: 'Consult', text: 'We connect, design together, and create the perfect plan.' },
  { icon: 'clipboard', title: 'Plan', text: 'We design the details and handle everything behind the scenes.' },
  { icon: 'check-circle', title: 'Prepare', text: 'Final details come together so you can feel completely at ease.' },
  { icon: 'sparkles', title: 'Celebrate', text: 'Relax and be present while we take care of every last detail.' },
  { icon: 'star', title: 'Remember', text: 'You enjoy every moment, knowing your event was in the best hands.' },
];

const values = [
  { icon: 'heart', title: "It's Personal", text: 'Every celebration tells a story. We take time to understand what matters most to you.' },
  { icon: 'sparkles', title: "It's Thoughtful", text: 'From the big picture to the smallest details, everything is planned with intention.' },
  { icon: 'compass', title: "It's Seamless", text: 'We handle the logistics behind the scenes so you can be fully present in the moment.' },
  { icon: 'star', title: "It's Memorable", text: 'Beautiful design and genuine moments come together to create lasting memories.' },
];
---
<Base title={undefined} transparentNav={true} current="/">
  <section class="hero">
    <div class="hero-bg">
      <img src="/images/hero-milestone-lakeside.jpg" alt="" class="slide" fetchpriority="high" />
      <img src="/images/reception-round-gold.jpg" alt="" class="slide" loading="lazy" decoding="async" />
      <img src="/images/reception-long-white.jpg" alt="" class="slide" loading="lazy" decoding="async" />
      <img src="/images/reception-navy-roses.jpg" alt="" class="slide" loading="lazy" decoding="async" />
      <img src="/images/reception-navy-banquet.jpg" alt="" class="slide" loading="lazy" decoding="async" />
      <img src="/images/reception-roses-navy.jpg" alt="" class="slide" loading="lazy" decoding="async" />
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">Milestones by Gloria</p>
      <h1 class="hero-title">Every Milestone Deserves</h1>
      <p class="hero-script script">a Lasting Memory</p>
      <p class="hero-tagline">{site.tagline}</p>
      <div class="hero-ctas">
        <a href={`https://cal.com/${site.calcomLink}`} target="_blank" rel="noopener" class="btn btn-primary">Book a Complimentary Consultation</a>
        <a href="/services" class="btn btn-ghost hero-ghost">View Services</a>
      </div>
    </div>
  </section>

  <Section bg="default">
    <div class="container-wide">
      <SectionHeading eyebrow="Thoughtfully Crafted" title="Services Designed for Life's Most Meaningful Moments" class="mb-7" />
      <div class="home-services">
        {homeServices.map((s) => (
          <a class="service-tile" href={s.href} aria-label={s.label}>
            <div class="service-media"><img src={s.image} alt={s.label} loading="lazy" decoding="async" /></div>
            <span class="service-icon"><Icon name={s.icon} size={30} /></span>
            <h3 class="service-label">{s.label}</h3>
            <p class="service-text">{s.text}</p>
          </a>
        ))}
      </div>
    </div>
  </Section>

  <Section bg="warm">
    <div class="container-wide text-center">
      <p class="eyebrow">The Milestones Experience</p>
      <h2 class="serif-h experience-title">Thoughtful Planning. Flawless Execution.</h2>
      <hr class="divider-gold center" />
      <ol class="experience-row mt-7">
        {experience.map((e, i) => (
          <li class="xp-step">
            <span class="xp-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="xp-icon"><Icon name={e.icon} size={30} /></span>
            <h3 class="xp-title">{e.title}</h3>
            <p class="xp-text">{e.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <Section bg="default">
    <div class="container">
      <div class="about-teaser">
        <div class="about-photo">
          <img src="/images/gloria-portrait.jpg" alt="Gloria Niyomahoro, founder of Milestones by Gloria" loading="lazy" decoding="async" />
        </div>
        <div class="about-copy">
          <p class="eyebrow">Meet Gloria</p>
          <h2 class="title-caps about-title">The Heart Behind Milestones by Gloria</h2>
          <hr class="divider-gold" />
          <p>Hello! I'm Gloria, the founder and lead planner behind Milestones by Gloria, where thoughtful planning meets timeless celebrations.</p>
          <p>With years of experience coordinating events, I create calm, beautiful, and unforgettable moments so you can be fully present with the people you love.</p>
          <a href="/about" class="btn btn-gold mt-5">Learn More About Me</a>
        </div>
      </div>
    </div>
  </Section>

  <Section bg="warm">
    <div class="container">
      <SectionHeading title="Meaningful Celebrations" script="Every detail, with heart" scriptPosition="above" class="mb-7" />
      <FeatureGrid items={values} columns={4} iconCircle />
    </div>
  </Section>

  <Section bg="default" tight>
    <div class="container text-center cta-banner">
      <p class="script cta-script">Let's create</p>
      <h2 class="title-caps cta-title">Something Beautiful Together</h2>
      <p class="cta-text">Whether you're just beginning to dream or counting down the days until your celebration, we'd be honoured to help bring your vision to life.</p>
      <a href={`https://cal.com/${site.calcomLink}`} target="_blank" rel="noopener" class="btn btn-primary mt-5">Book a Complimentary Consultation</a>
    </div>
  </Section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-bg { position: absolute; inset: 0; z-index: -2; }
  .hero-bg .slide {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center 40%; opacity: 0;
    animation: hero-fade 36s infinite; will-change: opacity;
  }
  .hero-bg .slide:nth-child(1) { animation-delay: -1s; }
  .hero-bg .slide:nth-child(2) { animation-delay: 5s; }
  .hero-bg .slide:nth-child(3) { animation-delay: 11s; }
  .hero-bg .slide:nth-child(4) { animation-delay: 17s; }
  .hero-bg .slide:nth-child(5) { animation-delay: 23s; }
  .hero-bg .slide:nth-child(6) { animation-delay: 29s; }
  @keyframes hero-fade {
    0% { opacity: 0; } 2.7% { opacity: 1; } 16.6% { opacity: 1; } 19.3% { opacity: 0; } 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg .slide { animation: none; opacity: 0; }
    .hero-bg .slide:nth-child(1) { opacity: 1; }
  }
  .hero-overlay {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgba(31,39,51,0.5) 0%, rgba(31,39,51,0.35) 45%, rgba(31,39,51,0.6) 100%);
  }
  .hero-content { text-align: center; color: var(--color-white); padding: var(--sp-8) var(--sp-5); max-width: 960px; }
  .hero-eyebrow { font-family: var(--font-sans); font-size: 0.78rem; letter-spacing: 0.32em; text-transform: uppercase; color: var(--color-accent-soft); margin-bottom: var(--sp-4); }
  .hero-title { font-family: var(--font-display); font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; font-size: clamp(2.2rem, 6vw, 4.5rem); line-height: 1.05; color: var(--color-white); text-shadow: 0 4px 30px rgba(0,0,0,0.3); }
  .hero-script { color: var(--color-accent-soft); font-size: clamp(2.6rem, 7vw, 5rem); line-height: 1; margin-top: -0.1em; }
  .hero-tagline { margin-top: var(--sp-5); font-family: var(--font-sans); font-size: clamp(0.68rem, 1.1vw, 0.85rem); letter-spacing: 0.28em; text-transform: uppercase; color: rgba(255,255,255,0.9); font-weight: 500; }
  .hero-ctas { margin-top: var(--sp-7); display: flex; gap: var(--sp-4); justify-content: center; flex-wrap: wrap; }
  .hero-ghost { color: #fff; border-color: rgba(255,255,255,0.7); }
  .hero-ghost:hover { background: #fff; color: var(--color-ink); }

  /* Services row (5 tiles) */
  .home-services { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--sp-5); }
  .service-tile { display: flex; flex-direction: column; align-items: center; text-align: center; color: inherit; }
  .service-media { width: 100%; aspect-ratio: 3 / 4; border-radius: var(--radius-sm); overflow: hidden; box-shadow: var(--shadow-soft); margin-bottom: var(--sp-4); }
  .service-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms ease; }
  .service-tile:hover .service-media img { transform: scale(1.04); }
  .service-icon { color: var(--color-accent); margin-bottom: var(--sp-2); }
  .service-label { font-family: var(--font-display); font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.92rem; margin-bottom: var(--sp-2); }
  .service-text { font-size: var(--fs-body-sm); color: var(--color-ink-soft); line-height: 1.5; }

  /* The Milestones Experience */
  .experience-title { font-size: var(--fs-h2); font-family: var(--font-serif); font-style: italic; }
  .experience-row { display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--sp-5); list-style: none; padding: 0; }
  .xp-step { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .xp-num { font-family: var(--font-display); color: var(--color-accent); font-size: 0.85rem; letter-spacing: 0.2em; margin-bottom: var(--sp-2); }
  .xp-icon { color: var(--color-accent); margin-bottom: var(--sp-3); }
  .xp-title { font-family: var(--font-display); font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.9rem; margin-bottom: var(--sp-2); }
  .xp-text { font-size: var(--fs-body-sm); color: var(--color-ink-soft); line-height: 1.5; }

  .about-teaser { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: var(--sp-8); align-items: center; }
  .about-photo { aspect-ratio: 4 / 5; border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-soft); }
  .about-photo img { width: 100%; height: 100%; object-fit: cover; }
  .about-copy p:not(.eyebrow) { color: var(--color-ink-soft); margin-top: var(--sp-4); max-width: 52ch; }
  .about-title { font-size: var(--fs-h2); }

  .cta-banner { max-width: 720px; margin: 0 auto; }
  /* Cream band — colours come from .script / .title-caps, so the closing CTA
     matches the hero's navy button and the rest of the light sections. */
  .cta-script { font-size: clamp(2rem, 4vw, 2.8rem); }
  .cta-title { font-size: var(--fs-h2); }
  .cta-text { margin-top: var(--sp-4); }

  @media (max-width: 1040px) {
    .home-services { grid-template-columns: repeat(3, 1fr); }
    .experience-row { grid-template-columns: repeat(3, 1fr); row-gap: var(--sp-7); }
  }
  @media (max-width: 820px) {
    .about-teaser { grid-template-columns: 1fr; gap: var(--sp-6); }
    /* Stacked: centre the capped photo, otherwise it hugs the left edge with
       a wide gap beside it. */
    .about-photo { max-width: 360px; margin: 0 auto; }
  }
  @media (max-width: 620px) {
    .home-services { grid-template-columns: repeat(2, 1fr); }
    .experience-row { grid-template-columns: repeat(2, 1fr); }
  }
</style>
