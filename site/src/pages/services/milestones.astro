---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Hero from '../../components/Hero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import PricingCard from '../../components/PricingCard.astro';
import EventCard from '../../components/EventCard.astro';
import CalcomButton from '../../components/CalcomButton.astro';
import { milestones as m } from '../../data/services';
import { eventsWePlan } from '../../data/events';
import { site } from '../../data/site';
import { serviceSchema } from '../../data/schema';

const description =
  'Birthday, baby shower, anniversary, engagement and graduation planning in Vancouver, BC. Every detail designed so you can be present. $90/hr, minimum 4 hours.';
---
<Base
  title="Milestone & Social Event Planning, Vancouver"
  current="/services"
  description={description}
  schema={serviceSchema({
    name: 'Milestone & Social Event Planning',
    description,
    path: '/services/milestones',
    hourlyRate: 90,
    priceNote: site.pricing.socialMin,
  })}
>
  <Hero
    eyebrow="Services"
    title={m.title}
    script={m.script}
    lead={m.intro}
    image={m.image}
    imageAlt={m.imageAlt}
  >
    <a href="/contact" class="btn btn-dark">Book a Complimentary Consultation</a>
  </Hero>

  <Section bg="warm">
    <div class="container-wide">
      <div class="intro-help">
        <div class="intro-copy">
          <p class="script intro-script">Celebrate</p>
          <h2 class="title-caps intro-title">Moments that Matter Most</h2>
          <hr class="divider-gold" />
          <p class="intro-lead">Life is full of milestones worth celebrating. At Milestones by Gloria, we believe every gathering should feel effortless, beautiful, and unforgettable.</p>
          <p class="intro-lead">Whether you're planning an intimate dinner or a celebration for hundreds of guests, we manage every detail with care so you can simply enjoy the occasion.</p>
        </div>
      </div>
      <div class="help-block">
        <SectionHeading title="How We Help" class="mb-7" />
        <FeatureGrid items={m.whatsIncluded} columns={6} iconCircle />
      </div>
    </div>
  </Section>

  <Section bg="default">
    <div class="container-wide">
      <SectionHeading title="Events We Plan" class="mb-7" />
      <div class="events-grid">
        {eventsWePlan.map((e) => (
          <EventCard image={e.image} title={e.title} text={e.text} alt={e.title} />
        ))}
      </div>
    </div>
  </Section>

  <Section bg="warm">
    <div class="container">
      <div class="process-invest">
        <div>
          <SectionHeading title="Our Process" align="left" class="mb-7" />
          <ProcessSteps steps={m.process} />
        </div>
        <div class="invest">
          <SectionHeading title="Investment" align="left" class="mb-7" />
          <PricingCard
            label="Social Event Planning"
            price={site.pricing.socialRate}
            sub={site.pricing.socialMin}
            note="Need more or fewer hours? Custom packages available to fit your event size, vision, and budget."
            align="left"
          >
            <CalcomButton label="Get a Custom Quote" />
          </PricingCard>
        </div>
      </div>
    </div>
  </Section>
</Base>

<style>
  .intro-help { margin-bottom: var(--sp-8); }
  .intro-copy { max-width: var(--container-narrow); }
  .intro-script { font-size: clamp(2.2rem, 5vw, 3.2rem); }
  .intro-title { font-size: var(--fs-h1); }
  .intro-lead { color: var(--color-ink-soft); margin-top: var(--sp-4); max-width: 60ch; }
  .events-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--sp-5);
  }
  .process-invest {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--sp-9);
    align-items: start;
  }
  .invest { position: sticky; top: calc(var(--nav-height) + var(--sp-6)); }
  @media (max-width: 1040px) { .events-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 860px) {
    .process-invest { grid-template-columns: 1fr; gap: var(--sp-8); }
    .invest { position: static; }
  }
  @media (max-width: 620px) { .events-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
