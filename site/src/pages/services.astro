---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventCard from '../components/EventCard.astro';
import { weddingCoordination, weddingPlanning, milestones, childcare, corporateEvents } from '../data/services';
import { site } from '../data/site';

const cards = [
  { label: weddingCoordination.navLabel, text: weddingCoordination.cardText, image: weddingCoordination.cardImage, href: '/services/wedding-coordination' },
  { label: weddingPlanning.navLabel, text: weddingPlanning.cardText, image: weddingPlanning.cardImage, href: '/services/wedding-planning' },
  { label: childcare.navLabel, text: childcare.cardText, image: childcare.cardImage, href: '/services/childcare' },
  { label: milestones.navLabel, text: milestones.cardText, image: milestones.cardImage, href: '/services/milestones' },
  { label: corporateEvents.navLabel, text: corporateEvents.cardText, image: corporateEvents.cardImage, href: '/services/corporate-events' },
];
---
<Base title="Services" current="/services" description="Wedding planning, wedding childcare, and milestone & social event planning by Milestones by Gloria.">
  <Section bg="default">
    <div class="container">
      <SectionHeading
        eyebrow="What We Offer"
        title="Services Designed for Life's Most Meaningful Moments"
      >
        <p>Three thoughtful ways we help you celebrate, each tailored to your story, your people, and your vision.</p>
      </SectionHeading>

      <div class="services-grid mt-8">
        {cards.map((s) => (
          <EventCard href={s.href} image={s.image} title={s.label} text={s.text} alt={s.label} />
        ))}
      </div>

      <div class="services-cta mt-8">
        <a href="/contact" class="btn btn-dark">Inquire About Your Event</a>
        <a href={`https://cal.com/${site.calcomLink}`} target="_blank" rel="noopener" class="btn btn-gold">Book a Consultation</a>
      </div>
    </div>
  </Section>
</Base>

<style>
  .services-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-5);
  }
  .services-grid > * { flex: 1 1 260px; max-width: 300px; }
  .services-cta { display: flex; flex-wrap: wrap; gap: var(--sp-4); justify-content: center; }
  @media (max-width: 480px) { .services-grid > * { max-width: 380px; } }
</style>
