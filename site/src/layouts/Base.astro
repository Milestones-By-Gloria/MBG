---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  transparentNav?: boolean;
  current?: string;
  hideFooter?: boolean;
  bodyClass?: string;
  /* Extra JSON-LD emitted alongside the site-wide LocalBusiness graph
     (e.g. a Service node on each service page). */
  schema?: Record<string, unknown>;
}

const {
  title,
  description = site.shortDescription,
  transparentNav = false,
  current = Astro.url.pathname,
  hideFooter = false,
  bodyClass = '',
  schema,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : site.name;
// Absolute URL so link previews (SMS, Facebook, etc.) resolve the image.
// Deliberately a hand-cut 1200x630 file in public/, NOT an astro:assets import:
// social scrapers cache by URL, and a content-hashed filename would change on
// every re-encode and invalidate every preview already in the wild.
const ogImage = new URL('/og-image.jpg', Astro.site).href;

// Site-wide structured data for local SEO (name, area served, socials, founder).
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://milestonesbygloria.ca/#business',
  name: site.name,
  description: site.shortDescription,
  url: 'https://milestonesbygloria.ca',
  email: site.email,
  telephone: site.phoneHref.replace('tel:', ''),
  image: ogImage,
  slogan: site.tagline,
  priceRange: '$$',
  // City-level only: the business does not publish a street address, so
  // PostalAddress is limited to locality/region rather than omitted entirely.
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Vancouver',
    addressRegion: 'BC',
    addressCountry: 'CA',
  },
  areaServed: [
    ...site.serviceCities.map((c) => ({ '@type': 'City', name: c })),
    { '@type': 'AdministrativeArea', name: 'British Columbia, Canada' },
  ],
  founder: { '@type': 'Person', name: site.founder.name },
  sameAs: [site.socials.instagram, site.socials.facebook].filter(Boolean),
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2B3547" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={Astro.url.href} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Fonts are now self-hosted via @fontsource and bundled with the build —
        no preconnect / no Google Fonts CDN. See src/styles/global.css. */}

    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class={bodyClass}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav transparent={transparentNav} current={current} />
    <main id="main">
      <slot />
    </main>
    {!hideFooter && <Footer />}

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--color-brown);
        color: var(--color-white);
        padding: var(--sp-3) var(--sp-4);
        z-index: 100;
      }
      .skip-link:focus { left: var(--sp-3); top: var(--sp-3); }
    </style>
  </body>
</html>
